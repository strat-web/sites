---
// Teste do <Tracking> perfil lead sem Rastro e em soft (WEB-84). Sai antes de o domínio virar (WEB-23).
import Layout from '@strat/kit/Layout.astro';
import TesteTracking from '@strat/kit/TesteTracking.astro';
---
<Layout marca="agencia" perfil="lead" indexar={false}
  titulo="Teste do Tracking, perfil lead em soft · Agência Strat"
  descricao="Página de teste do componente Tracking do kit dos sites: perfil lead da Agência em soft, com MetricaaS e o aviso de cookies.">
  <TesteTracking perfil="lead" whatsapp="554831994338" esperado={[
    'Na abertura: t.metricaas.com.br/m.js (data-ws=strat-marketing, data-pixel, sem data-pixel-consent) e o beacon /e do MetricaaS.',
    'Na abertura, sem esperar escolha: fbevents.js e PageView do pixel 1815630929780241 (facebook.com/tr). O aviso aparece com Recusar e Ok.',
    'Depois de Recusar: nenhum facebook.com/tr novo (clique no WhatsApp ou recarregue a página: sem /tr). Ok: segue medindo.',
    'Recusa guardada (strat_cookies=nao): ao recarregar, sem aviso e sem PageView do pixel.',
    'Ok guardado (strat_cookies=ok): ao recarregar, sem aviso e com PageView; numa página em banner (home), o banner aparece de novo.',
    'Sem Rastro, sem GA4 e sem tag do Google (a Agência não usa: T3, WEB-73).',
  ]} />
</Layout>
