---
// WEB-23: conteúdo do strat-lps 05ca028, preservado; SEO e tracking vêm do kit.
import Layout from '@strat/kit/Layout.astro';
import head from '../html/home.head.html?raw';
import corpo from '../html/home.corpo.html?raw';
---
<Layout
  marca="agencia"
  perfil="lead"
  titulo="Agência Strat · Tráfego, social e conteúdo com IA"
  descricao="A Agência Strat cuida dos seus anúncios, das suas redes e do seu conteúdo, com IA em cada etapa e tudo medido no número que importa: cliente novo."
  descricaoSocial="A Agência Strat cuida dos seus anúncios, das suas redes e do seu conteúdo, com IA em cada etapa e tudo medido no número que importa: cliente novo."
  imagem="/midia/og.png"
>
  <Fragment slot="head" set:html={head} />
  <Fragment set:html={corpo} />
</Layout>
