---
import { withBase, absUrl } from './src/url';
import { slugifyTag } from './src/slugify';

interface Author {
  role: string;
  bio: string;
  sameAs: string[];
}
interface SiteMeta {
  name: string;
  description: string;
  lang: string;
  locale: string;
  twitter: string;
  author: { name: string; url: string; sameAs: readonly string[] };
}
interface Props {
  site: SiteMeta;
  authors?: Record<string, Author>;
  title: string;
  headline?: string;
  description: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  tags?: string[];
  breadcrumb?: { name: string; url: string }[];
  faq?: { q: string; a: string }[];
  /** Página que não deve ir ao Google (ex.: obrigado). Também precisa sair do sitemap. */
  noindex?: boolean;
}

const {
  site,
  authors = {},
  title,
  headline,
  description,
  type = 'website',
  image,
  publishedTime,
  modifiedTime,
  author = site.author.name,
  tags = [],
  breadcrumb,
  faq,
  noindex = false,
} = Astro.props;

const origin = String(import.meta.env.SITE);
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = image ?? absUrl('/og-default.png');
const ogTitle = headline ?? title;

const authorInfo = authors[author];
const authorUrl = absUrl(`/blog/autor/${slugifyTag(author)}/`);
const authorSameAs = authorInfo?.sameAs ?? site.author.sameAs;

const breadcrumbLd =
  breadcrumb && breadcrumb.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumb.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: absUrl(b.url),
        })),
      }
    : null;

const faqLd =
  faq && faq.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;

const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: ogTitle,
        description,
        image: ogImage,
        datePublished: publishedTime?.toISOString(),
        dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
        author: { '@type': 'Person', name: author, url: authorUrl, sameAs: authorSameAs },
        publisher: { '@type': 'Organization', name: site.name, url: origin },
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
        keywords: tags.join(', '),
        inLanguage: site.lang,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: site.name,
        url: origin,
        description: site.description,
        inLanguage: site.lang,
      };
---
<script is:inline>document.documentElement.classList.add('js');</script>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="author" content={author} />

<meta property="og:type" content={type} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={site.twitter} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="alternate" type="application/rss+xml" title={site.name} href={absUrl('/rss.xml')} />
<link rel="sitemap" href={withBase('/sitemap.xml')} />

{/* Sem preload da Clash Display, da Switzer e da JetBrains Mono (vieram do horus): o site é todo em Rubik (fontsource)
    e na mono do sistema, nenhuma regra usa essas três, e os ~140 KB pré-carregados disputavam a banda com o texto do LCP
    no celular (WEB-49). */}
<!-- Material Symbols servido pelo app (WEB-49): antes vinha do fonts.googleapis.com e travava a renderização (~650 ms no
     celular). O woff2 é o subconjunto que o Google gerava para os ícones abaixo; ícone novo pede baixar o subconjunto
     de novo com o nome dele. Ícones: account_tree,add,arrow_back,arrow_forward,arrow_right,article,auto_awesome,bolt,brush,bug_report,build,business_center,calendar_month,calendar_today,chat,check,close,code,compare_arrows,construction,content_copy,content_paste_search,database,draft,edit_document,edit_note,error,event,extension,folder_managed,folder_open,forum,graph_3,group,groups,hourglass_empty,hub,info,lightbulb,link,list,live_tv,location_on,lock,mail,menu,menu_book,movie,movie_filter,neurology,newspaper,palette,play_circle,psychology,public,redeem,remove,rocket_launch,rule,schedule,school,search,settings,settings_suggest,share,shield,smart_toy,speed,storage,supervisor_account,support_agent,swap_horiz,terminal,travel_explore,trending_down,trending_up,update,video_library,warning,webhook,work,workspace_premium -->
<style is:inline>
@font-face{font-family:'Material Symbols Outlined';font-style:normal;font-weight:400;font-display:swap;src:url(/fonts/MaterialSymbolsOutlined-subset.woff2) format('woff2')}
.material-symbols-outlined{font-family:'Material Symbols Outlined';font-weight:normal;font-style:normal;font-size:24px;line-height:1;letter-spacing:normal;text-transform:none;display:inline-block;white-space:nowrap;word-wrap:normal;direction:ltr;-webkit-font-feature-settings:'liga';-webkit-font-smoothing:antialiased}
</style>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
{breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
{faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
