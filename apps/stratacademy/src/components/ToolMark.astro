---
/**
 * Marca geométrica por ferramenta — motivo abstrato on-brand, não logo de terceiro.
 * Inline (zero requisição). Herda a cor via currentColor.
 */
interface Props {
  mark: string;
  size?: number;
  class?: string;
}
const { mark, size = 48, class: cls = '' } = Astro.props;

const P: Record<string, string> = {
  // terminal: moldura + prompt
  'claude-code': `<rect x="6" y="12" width="52" height="40" rx="2"/><path d="M6 22h52"/><circle cx="12.5" cy="17" r="1.6" fill="currentColor" stroke="none"/><path d="M16 32l7 6-7 6M27 44h13"/>`,
  // nós conectados
  'n8n': `<circle cx="12" cy="32" r="6"/><circle cx="32" cy="17" r="6"/><circle cx="32" cy="47" r="6"/><circle cx="52" cy="32" r="6"/><path d="M17.2 29l9.6-7.2M17.2 35l9.6 7.2M37.2 20l9.6 7.2M37.2 44l9.6-7.2"/>`,
  // cursor dentro do quadro
  'cursor': `<rect x="6" y="6" width="52" height="52" rx="2"/><path d="M24 20l18 16-8 1.5 4.5 9.5-4 2-4.5-9.5-6 5.5z"/>`,
  // coração geométrico
  'lovable': `<path d="M32 52L13 34a11.5 11.5 0 0 1 19-12 11.5 11.5 0 0 1 19 12z"/><path d="M32 22v30" opacity=".45"/>`,
  // branch
  'github': `<circle cx="18" cy="15" r="6"/><circle cx="18" cy="49" r="6"/><circle cx="46" cy="27" r="6"/><path d="M18 21v22M24 27h11a5 5 0 0 1 5 5v6" opacity=".9"/><path d="M40 32v-.5"/>`,
  // sparkle de 4 pontas
  'ai-studio': `<path d="M32 8l5.5 15.5L53 29l-15.5 5.5L32 50l-5.5-15.5L11 29l15.5-5.5z"/><circle cx="49" cy="49" r="4"/><circle cx="15" cy="14" r="2.5" opacity=".6"/>`,
  // arco / antigravidade
  'antigravity': `<path d="M8 52a24 24 0 0 1 48 0"/><path d="M18 52a14 14 0 0 1 28 0" opacity=".55"/><path d="M32 30V8M32 8l-6 7M32 8l6 7"/>`,
  // crescente
  'nano-banana': `<path d="M44 12a24 24 0 1 0 8 20 18 18 0 0 1-8-20z"/><circle cx="41" cy="24" r="2.5" fill="currentColor" stroke="none" opacity=".7"/>`,
  // campo de ondas
  'higgsfield': `<path d="M6 40c8-14 16-14 24 0s16 14 24 0"/><path d="M6 26c8-14 16-14 24 0s16 14 24 0" opacity=".5"/><path d="M6 54c8-14 16-14 24 0s16 14 24 0" opacity=".28"/>`,
  // loop contínuo
  'kling': `<path d="M22 32a10 10 0 1 1 10 10 10 10 0 1 0 10-10 10 10 0 1 1-10-10 10 10 0 1 0-10 10z"/>`,
  // play triplo (avatar/vídeo)
  'heygen': `<circle cx="32" cy="22" r="9"/><path d="M12 54a20 20 0 0 1 40 0"/><path d="M29 19l6 3.5-6 3.5z" fill="currentColor" stroke="none"/>`,
  // parceiros sem marca canônica aberta
  'zapi': `<rect x="8" y="6" width="48" height="44" rx="8"/><path d="M20 50l-6 8v-8"/><path d="M20 20h24M20 28h18M20 36h22"/>`,
  'brdid': `<circle cx="32" cy="32" r="24"/><path d="M32 8c7 7 7 41 0 48M32 8c-7 7-7 41 0 48M9 22h46M9 42h46"/>`,
  'asaas': `<rect x="6" y="14" width="52" height="36" rx="6"/><path d="M6 26h52"/><path d="M16 40h12"/><circle cx="46" cy="40" r="4"/>`,
  'opusclip': `<rect x="6" y="12" width="34" height="40" rx="4"/><path d="M46 20l12-5v34l-12-5z"/><path d="M18 26l10 6-10 6z" fill="currentColor" stroke="none"/>`,
  // agente da casa
  'hermes': `<path d="M32 8l20 11v14c0 12-8.5 19.5-20 23-11.5-3.5-20-11-20-23V19z"/><circle cx="32" cy="28" r="5"/><path d="M22 45c2.5-5 17.5-5 20 0"/>`,
  // evento presencial
  'imersao': `<path d="M32 6l26 13-26 13L6 19z"/><path d="M14 25v14c0 5 8 9 18 9s18-4 18-9V25"/><path d="M56 20v14"/>`,
  // evento online
  'bootcamp': `<rect x="6" y="12" width="52" height="34" rx="2"/><path d="M22 54h20M32 46v8"/><path d="M28 22l10 7-10 7z" fill="currentColor" stroke="none"/>`,
};

const d = P[mark] ?? P['claude-code'];
---
<svg
  width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false"
  fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"
  class={cls}
  set:html={d}
/>
