---
// Um modelo de funil por página. Cada uma pega uma busca própria
// ("funil de vendas para e-commerce", "funil de vendas B2B") e entrega a
// ferramenta já preenchida com os números daquele tipo de negócio.
//
// Mesma regra da folha: o modelo inteiro — etapas, taxas e o gargalo típico —
// é renderizado no build, em texto e em tabela. Não depende de JavaScript.
import RubikLayout from '../../../../layouts/RubikLayout.astro';
import FunilTool from '../../../../components/FunilTool.astro';
import Selo from '../../../../components/Selo.astro';
import { SITE } from '../../../../consts';
import { absUrl } from '@horus/seo';
import { PLANO, HUB } from '../../../../data/catalogo';
import { MODELOS_FUNIL, buscarFerramenta, rotaFerramenta, type ModeloFunil } from '../../../../data/ferramentas';
import { calcularFunil, fmtNum, fmtReal, fmtTaxa } from '../../../../lib/funil';

export function getStaticPaths() {
  return MODELOS_FUNIL.map((m) => ({ params: { slug: m.slug }, props: { modelo: m } }));
}

interface Props { modelo: ModeloFunil }
const { modelo } = Astro.props;

const f = buscarFerramenta('calculadora-de-funil-de-vendas')!;
const base = rotaFerramenta(f.slug);
const url = `${base}/modelos/${modelo.slug}`;

const calc = calcularFunil(modelo.etapas, modelo.ticket);
const outros = MODELOS_FUNIL.filter((m) => m.slug !== modelo.slug);

const faq = [
  {
    q: `Estes números de funil ${modelo.nome} são reais?`,
    a: 'São valores de referência plausíveis para esse tipo de negócio, escolhidos para o modelo fazer sentido como ponto de partida — não são a média do seu setor. Troque pelos seus assim que tiver a medição do último mês; é a comparação com o seu próprio histórico que importa.',
  },
  {
    q: 'Posso mudar as etapas deste modelo?',
    a: 'Pode. As etapas são um ponto de partida do formato mais comum desse tipo de venda. Se o seu processo tem um degrau a mais que você consegue medir, acrescente; se tem uma etapa que você não mede de verdade, tire — etapa sem número confiável piora o diagnóstico.',
  },
  {
    q: 'Preciso criar conta para usar este modelo?',
    a: 'Não. O modelo abre preenchido e o cálculo roda no seu navegador, sem enviar nada. Só se você pedir o diagnóstico por e-mail é que os números vão para nós, junto com o contato.',
  },
];
---

<RubikLayout
  perfil="lead"
  title={`${modelo.titulo} — modelo gratuito — ${SITE.name}`}
  description={`${modelo.resumo} Modelo pronto para editar, com as etapas, as taxas de conversão de cada passagem e o gargalo que costuma aparecer.`}
  faq={faq}
  image={absUrl(`/og/funil-${modelo.slug}.png`)}
  breadcrumb={[
    { name: 'Início', url: '/' },
    { name: 'Ferramentas', url: '/ferramentas' },
    { name: f.nome, url: base },
    { name: modelo.nome, url },
  ]}
>
  <div class="topo">
    <div class="aura" aria-hidden="true"></div>
    <section class="hero wrap">
      <nav class="migalhas rise d1" aria-label="Você está em">
        <a href="/">Início</a><span>/</span>
        <a href="/ferramentas">Ferramentas</a><span>/</span>
        <a href={base}>Calculadora de funil</a><span>/</span>{modelo.nome}
      </nav>
      <p class="kicker rise d1">Modelo pronto · grátis e sem cadastro</p>
      <h1 class="rise d2">{modelo.titulo}</h1>
      <p class="lead rise d3">{modelo.paraQuem}</p>
    </section>
  </div>

  <section class="wrap secao secao-topo">
    <FunilTool
      etapas={modelo.etapas}
      ticket={modelo.ticket}
      titulo={`Funil de ${modelo.nome}, já preenchido`}
      intro="Os números são de referência para esse tipo de negócio. Troque pelos seus — o cálculo é refeito na hora, no seu navegador."
      local={`modelo-${modelo.slug}`}
    />
  </section>

  <section class="wrap secao">
    <div class="sec-head">
      <p class="kicker">O modelo em número</p>
      <h2>As etapas deste funil, uma a uma</h2>
      <p class="lead">
        A mesma leitura do quadro acima, escrita — para conferir sem depender da tela e para saber o
        que contar em cada etapa quando for medir o seu.
      </p>
    </div>

    <div class="tabela-rola">
      <table class="tabela-modelo">
        <thead>
          <tr>
            <th>Etapa</th>
            <th>Quantidade</th>
            <th>Da etapa anterior</th>
            <th>Do topo</th>
            <th>O que contar aqui</th>
          </tr>
        </thead>
        <tbody>
          {calc.etapas.map((e) => (
            <tr class:list={[e.gargalo && 'e-gargalo']}>
              <th scope="row">{e.nome}{e.gargalo && <span class="selo">gargalo</span>}</th>
              <td class="num">{fmtNum(e.valor)}</td>
              <td class="num">{e.taxaPassagem === null ? '—' : fmtTaxa(e.taxaPassagem)}</td>
              <td class="num">{fmtTaxa(e.taxaAcumulada)}</td>
              <td>{e.nota}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="resumo-num">
      Neste modelo, a conversão do topo até a venda é de <b>{fmtTaxa(calc.taxaGeral)}</b>. Com ticket
      médio de {fmtReal(modelo.ticket)}, o funil gera <b>{fmtReal(calc.receita)}</b> no período —
      e cada ponto percentual a mais na passagem de {calc.gargalo?.nome} vale
      <b>{fmtReal(calc.ganhoPorPonto)}</b>.
    </p>
  </section>

  <section class="wrap secao" id="quando-usar">
    <div class="grade grade-2">
      <div class="card card-largo">
        <h3>Quando usar este modelo</h3>
        <p>{modelo.quandoUsar}</p>
      </div>
      <div class="card card-largo">
        <h3>O que observar ao medir</h3>
        <p>{modelo.oQueObservar}</p>
      </div>
    </div>
  </section>

  <section class="wrap secao">
    <div class="quadro">
      <p class="kicker">O gargalo típico</p>
      <h2>Onde este tipo de funil costuma vazar</h2>
      <p>{modelo.gargaloTipico}</p>
      <p>
        No modelo acima, o gargalo cai na passagem de <b>{calc.gargalo?.nome}</b>, com
        {' '}{fmtTaxa(calc.gargalo?.taxaPassagem ?? 0)} — a pior taxa das
        {' '}{calc.etapas.length - 1} passagens. Se o seu funil real tiver o gargalo em outro lugar,
        confie no seu número, não no modelo.
      </p>
    </div>
  </section>

  <section class="wrap secao">
    <div class="sec-head">
      <p class="kicker">Outros modelos</p>
      <h2>Se o seu negócio não é bem este</h2>
    </div>
    <div class="grade grade-3">
      {outros.map((m) => (
        <a href={`${base}/modelos/${m.slug}`} class="card">
          <h3>{m.nome}</h3>
          <p>{m.resumo}</p>
          <span class="ver">Abrir modelo →</span>
        </a>
      ))}
    </div>
    <p class="volta">
      <a href={base} class="btn btn-ghost">← Voltar para a calculadora de funil de vendas</a>
    </p>
    <Selo ferramenta={f} variante="bloco" />
  </section>

  <section class="wrap secao">
    <div class="sec-head">
      <p class="kicker">Dúvidas</p>
      <h2>Perguntas frequentes</h2>
    </div>
    <div class="faq">
      {faq.map((q) => <details><summary>{q.q}</summary><p>{q.a}</p></details>)}
    </div>
  </section>

  <section class="wrap secao">
    <div class="cta">
      <p class="kicker">Strat Hub</p>
      <h2>Achou o gargalo. Agora automatize o que sobrou.</h2>
      <p class="lead">
        Saber onde o funil vaza é metade. A outra metade é montar a automação que resolve — e é isso
        que as Masterclasses de N8N e Claude Code ensinam, liberadas por inteiro na conta gratuita do
        Strat Hub. Sem cartão.
      </p>
      <a href={HUB} data-evento="SignUpIntent" data-evento-local={`modelo-${modelo.slug}`} class="btn btn-primario">{PLANO.chamada}</a>
      <p class="nota">{PLANO.nome} · {PLANO.preco}{PLANO.periodo} quando quiser assinar · cancela quando quiser</p>
    </div>
  </section>
</RubikLayout>

<style>
  .secao-topo { padding-top: var(--s3); }

  .tabela-modelo { width: 100%; border-collapse: collapse; font-size: var(--t-peq); }
  .tabela-modelo th, .tabela-modelo td {
    text-align: left; padding: var(--s2);
    border-bottom: 1px solid var(--linha); vertical-align: top;
  }
  .tabela-modelo thead th { font-size: var(--t-meta); color: var(--txt-2); font-weight: var(--w-semi); }
  .tabela-modelo tbody th { font-weight: var(--w-semi); white-space: nowrap; }
  .tabela-modelo td { color: var(--txt-2); }
  .tabela-modelo .num { font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--txt); }
  .tabela-modelo tr.e-gargalo { background: var(--bg-2); }
  .selo {
    display: inline-block; margin-left: .5rem;
    background: var(--acento); color: #fff;
    font-size: .68rem; font-weight: var(--w-bold);
    padding: .1rem .45rem; border-radius: 999px;
    text-transform: uppercase; letter-spacing: .04em;
  }

  .resumo-num {
    margin-top: var(--s4); color: var(--txt-2);
    max-width: var(--leitura); font-size: var(--t-peq);
  }
  .resumo-num b { color: var(--txt); }

  .quadro {
    background: var(--surf); border-radius: var(--raio-g);
    box-shadow: var(--sombra-card); padding: var(--s5);
  }
  .quadro h2 { font-size: var(--t-h3); font-weight: var(--w-semi); margin-bottom: var(--s3); }
  .quadro p { color: var(--txt-2); max-width: var(--leitura); }
  .quadro p + p { margin-top: var(--s3); }
  .quadro p b { color: var(--txt); }

  .volta { margin-top: var(--s4); }

  @media (max-width: 640px) { .quadro { padding: var(--s4) var(--s3); } }
</style>
