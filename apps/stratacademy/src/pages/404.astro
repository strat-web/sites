---
import RubikLayout from '../layouts/RubikLayout.astro';
import { SITE } from '../consts';
---
<RubikLayout perfil={null} noindex title={`Página não encontrada — ${SITE.name}`} description="A página que você procura não existe ou foi movida.">
  <div class="topo">
    <div class="aura" aria-hidden="true"></div>
    <section class="wrap aviso">
      <p class="simbolo" aria-hidden="true">404</p>
      <h1>Página não encontrada</h1>
      <p class="lead">O link pode estar quebrado ou a página foi movida. Que tal voltar e explorar os artigos?</p>
      <div class="cta-row" style="justify-content:center">
        <a href="/" class="btn btn-primario">Ir para a home</a>
        <a href="/blog/" class="btn btn-secundario">Ver artigos</a>
      </div>
    </section>
  </div>
</RubikLayout>
