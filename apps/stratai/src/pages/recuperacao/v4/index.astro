---
// Funil de recuperação de vendas, V4 (telas, com compra rápida e call com o Helbert no fim) — WEB-91, vindo da DEV-94. O miolo vem de src/html/recuperacao/
// (gerado pelo FunilRecuperacao-StratAI/scripts/para-o-repo.py); texto e regras em public/recuperacao/comum/funil.js.
// Tracking pelo kit (linha "stratai-recuperacao-v4" do catálogo): Rastro stratai e MetricaaS agencia-strat. O lead sai
// por mtc.lead() no fim, só em stratai.com.br. Rascunho: noindex até os cases e o low ticket terem conteúdo.
import Layout from '@strat/kit/Layout.astro';
import head from '../../../html/recuperacao/v4.head.html?raw';
import corpo from '../../../html/recuperacao/v4.corpo.html?raw';
---
<Layout
  marca="stratai"
  perfil="lead"
  indexar={false}
  titulo="Recuperação de vendas com call com o Helbert · StratAI"
  descricao="A gente recupera Pix, boleto e carrinho abandonado e fica com 15% só do que voltar. No fim, fale direto com o Helbert."
  imagem="/midia/og.png"
  viewport="width=device-width, initial-scale=1, viewport-fit=cover"
>
  <Fragment slot="head" set:html={head} />
  <Fragment set:html={corpo} />
</Layout>
