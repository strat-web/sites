---
// Funil de recuperação de vendas, V2 (raio-x ao vivo) — WEB-91, vindo da DEV-94. O miolo vem de src/html/recuperacao/
// (gerado pelo FunilRecuperacao-StratAI/scripts/para-o-repo.py); texto e regras em public/recuperacao/comum/funil.js.
// Tracking pelo kit (linha "stratai-recuperacao-v2" do catálogo): Rastro stratai e MetricaaS agencia-strat. O lead sai
// por mtc.lead() no fim, só em stratai.com.br. Rascunho: noindex até os cases e o low ticket terem conteúdo.
import Layout from '@strat/kit/Layout.astro';
import head from '../../../html/recuperacao/v2.head.html?raw';
import corpo from '../../../html/recuperacao/v2.corpo.html?raw';
---
<Layout
  marca="stratai"
  perfil="lead"
  indexar={false}
  titulo="Raio-X da recuperação de vendas · StratAI"
  descricao="Descubra quanto dinheiro está parado no Pix gerado, no boleto e no carrinho abandonado. A gente recupera e fica com 15% só do que voltar."
  imagem="/midia/og.png"
  viewport="width=device-width, initial-scale=1, viewport-fit=cover"
>
  <Fragment slot="head" set:html={head} />
  <Fragment set:html={corpo} />
</Layout>
