---
// Teste do <Tracking> perfil conteudo (WEB-17): o mesmo do site da StratAI, sem formulário de lead.
import Layout from '@strat/kit/Layout.astro';
import TesteTracking from '@strat/kit/TesteTracking.astro';
---
<Layout marca="stratai" perfil="conteudo" indexar={false}
  titulo="Teste do Tracking, perfil conteúdo · StratAI"
  descricao="Página de teste do componente Tracking do kit dos sites: perfil conteúdo, igual ao site da marca e sem evento de lead.">
  <TesteTracking perfil="conteudo" esperado={[
    'Os mesmos scripts do site da StratAI: m.js (agencia-strat) e /sa?product=stratai.',
    'PageView do pixel 1823024821883911 uma vez e page_view do GA4. Nenhum Lead: a página não tem formulário.',
    'Sem launcher da Hotmart.',
  ]} />
</Layout>
