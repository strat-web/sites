---
// Corpo das páginas de teste do <Tracking> (WEB-17): mostra o perfil, a linha do catálogo e o que deve disparar,
// com um botão (data-strat-cta), um link de WhatsApp e uma seção marcada (data-mtc-section). Formulário de lead não
// entra: o Rastro e o MetricaaS criariam lead de verdade no funil.
import catalogo from '../../../catalogo/sites.json';
import { planoDeTracking } from './tracking.js';
import { urlCanonica } from './schema.js';

interface Props {
  perfil: 'venda' | 'lead' | 'conteudo';
  esperado: string[];   // o que conferir na aba Rede do navegador
  whatsapp?: string;    // número no formato do wa.me (55 + DDD + número)
  checkout?: string;    // link da Hotmart, no perfil venda
}

const { perfil, esperado, whatsapp, checkout } = Astro.props;
const url = urlCanonica(Astro.site, Astro.url.pathname);
const { linha, scripts, hotmart, banner } = planoDeTracking({ catalogo, url, perfil });
const texto = encodeURIComponent('Olá! Teste do kit de tracking (WEB-17), pode ignorar.');
---
<main id="topo" style="max-width:720px;margin:0 auto;padding:32px 16px;font:16px/1.6 system-ui,sans-serif">
  <h1>Teste do Tracking · perfil {perfil}</h1>
  <p>Página de teste do componente <code>&lt;Tracking&gt;</code> do kit. Abra com
    <code>?utm_source=teste&amp;utm_medium=verificacao</code> e confira a aba Rede. Fica fora do índice e sai antes
    de o domínio virar para este repositório.</p>

  <section data-mtc-section="teste-catalogo">
    <h2>Linha do catálogo</h2>
    <ul>
      <li>id: <code>{linha.id}</code> · marca: <code>{linha.marca}</code> · consentimento: <code>{linha.consentimento}</code></li>
      <li>Rastro: <code>{linha.rastro_slug ?? 'não usa'}</code> · MetricaaS: <code>{linha.metricaas_ws ?? 'não usa'}</code> · pixel: <code>{linha.meta_pixel ?? '—'}</code></li>
      <li>Scripts no &lt;head&gt;: {scripts.map((s) => <code style="display:block">{s.src}</code>)}</li>
      <li>Launcher da Hotmart: {hotmart ? 'sim' : 'não'} · banner de cookies do kit: {banner ? 'sim' : 'não'}</li>
    </ul>
  </section>

  <section data-mtc-section="teste-esperado">
    <h2>O que deve disparar</h2>
    <ul>{esperado.map((e) => <li>{e}</li>)}</ul>
  </section>

  <section data-mtc-section="teste-botoes">
    <h2>Botões</h2>
    <p><a href="#topo" data-strat-cta="teste-cta">Botão de teste (data-strat-cta="teste-cta")</a></p>
    {whatsapp && <p><a href={`https://wa.me/${whatsapp}?text=${texto}`} data-strat-cta="teste-whatsapp" rel="noopener">WhatsApp de teste (não precisa mandar a mensagem)</a></p>}
    {checkout && <p><a href={checkout} data-strat-cta="teste-checkout">Checkout da Hotmart (o Rastro acrescenta xcod e UTMs no href)</a></p>}
  </section>
</main>
