---
// Página pós-cadastro ("entre no grupo") de todos os funis da Academy, migrada do strat-lps (lps/comunidade/index.html)
// sem mudar texto, layout nem tracking (WEB-48). O funil chega pelo ?f=<chave>: o registro FUNIS, no script do corpo,
// escolhe a copy e o grupo do WhatsApp. O Rastro do funil vem do <Tracking> do kit (consentimento "por-funil" e
// registro "funis" no catálogo, docs/tracking.md; WEB-106): sem ?f= ou com funil desconhecido, nada carrega, de propósito.
import Layout from '@strat/kit/Layout.astro';
import head from '../html/home.head.html?raw';
import corpo from '../html/home.corpo.html?raw';
---
<Layout
  marca="academy"
  perfil="conteudo"
  titulo="Cadastro confirmado · entre no grupo · Strat"
  descricao="Seu cadastro está confirmado. Entre no grupo do WhatsApp pra receber o acesso."
  indexar={false}
  viewport="width=device-width, initial-scale=1.0"
>
  <Fragment slot="head" set:html={head} />
  <Fragment set:html={corpo} />
</Layout>
