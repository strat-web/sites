{
  "name": "strat-web-sites",
  "private": true,
  "version": "0.0.0",
  "description": "Sites, LPs e blogs do Grupo Strat (monorepo Astro no Cloudflare Pages).",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "dev:agenciastrat": "pnpm --filter @strat/agenciastrat dev",
    "dev:stratai": "pnpm --filter @strat/stratai dev",
    "dev:stratacademy": "pnpm --filter @strat/stratacademy dev",
    "dev:metricaas": "pnpm --filter @strat/metricaas dev",
    "checar": "pnpm build && pnpm test",
    "test": "pnpm -r --if-present run test"
  }
}
