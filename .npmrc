engine-strict=false
auto-install-peers=true
# Pacotes das ferramentas da Academy (funil e WhatsApp), privados no GitHub Packages (WEB-49). Aqui só o endereço:
# a credencial nunca entra no repositório. Na máquina: NPM_TOKEN no ambiente e um .npmrc de usuário fora do repo com
# //npm.pkg.github.com/:_authToken=${NPM_TOKEN}. No Pages e na CI: segredo NPM_TOKEN (docs/pages.md).
@strat-ai-horus-os:registry=https://npm.pkg.github.com
